<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DataSync" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/midnight_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.DataSync.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/midnight_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.DataSync</item>
    </style>
</resources>
